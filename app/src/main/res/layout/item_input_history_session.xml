<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/activity_margin"
    android:layout_marginTop="@dimen/small_margin"
    android:layout_marginEnd="@dimen/activity_margin"
    android:layout_marginBottom="@dimen/small_margin"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorControlHighlight"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- Header: App Label, Package, and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/session_app_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="WhatsApp" />

                <TextView
                    android:id="@+id/session_app_package"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:ellipsize="end"
                    android:lines="1"
                    android:textSize="12sp"
                    tools:text="com.whatsapp" />

            </LinearLayout>

            <TextView
                android:id="@+id/session_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="SENT" />

        </LinearLayout>

        <!-- Meta info: Timestamp and Deletions count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/session_timestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:textSize="12sp"
                tools:text="Oct 24, 10:24 AM" />

            <TextView
                android:id="@+id/session_deletions_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:textSize="12sp"
                tools:text="2 deletions" />

        </LinearLayout>

        <!-- Content Box: Interleaved text with deleted spans in Red and NO reflow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/clipboard_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/session_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textIsSelectable="true"
                android:textSize="15sp"
                tools:text="Hello world (with deleted text in red)" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
