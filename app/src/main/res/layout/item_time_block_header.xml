<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/activity_margin"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="@dimen/activity_margin"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/block_time_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/ic_access_time_vector"
        app:tint="?attr/colorControlNormal" />

    <TextView
        android:id="@+id/block_time_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="14:00 - 16:00" />

    <TextView
        android:id="@+id/block_sessions_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_all_corners_medium"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="4 sessions · 2 apps" />

</LinearLayout>
