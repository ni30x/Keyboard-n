<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="@dimen/activity_margin"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorControlHighlight"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Exact Time, Status Badge, Deletions count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/session_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="14:15:22" />

            <TextView
                android:id="@+id/session_deletions_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:alpha="0.75"
                android:textSize="11sp"
                tools:text="1 deletion" />

            <TextView
                android:id="@+id/session_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="SENT" />

        </LinearLayout>

        <!-- Content Box: Interleaved text with deleted spans in Red and NO reflow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/clipboard_background"
            android:padding="10dp">

            <TextView
                android:id="@+id/session_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textIsSelectable="true"
                android:textSize="14sp"
                tools:text="Session text with deleted spans in red" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
