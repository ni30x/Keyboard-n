<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:app="http://schemas.android.com/apk/res-auto">
    <Row>
        <Key
            app:keyEdgeFlags="left"
            app:keyLabel="1"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="2"
            app:keySublabel="ABC"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="3"
            app:keySublabel="DEF"
            app:keyWidth="25%p" />
        <Key
            app:keyEdgeFlags="right"
            app:keyLabel="-"
            app:keyWidth="25%p" />
    </Row>
    <Row>
        <Key
            app:keyEdgeFlags="left"
            app:keyLabel="4"
            app:keySublabel="GHI"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="5"
            app:keySublabel="JKL"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="6"
            app:keySublabel="MNO"
            app:keyWidth="25%p" />
        <Key
            app:code="32"
            app:keyEdgeFlags="right"
            app:keyLabel="␣"
            app:keyWidth="25%p" />
    </Row>
    <Row>
        <Key
            app:keyEdgeFlags="left"
            app:keyLabel="7"
            app:keySublabel="PQRS"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="8"
            app:keySublabel="TUV"
            app:keyWidth="25%p" />
        <Key
            app:keyLabel="9"
            app:keySublabel="WXYZ"
            app:keyWidth="25%p" />
        <Key
            app:code="-5"
            app:isRepeatable="true"
            app:keyEdgeFlags="right"
            app:keyIcon="@drawable/ic_clear_vector"
            app:keyWidth="25%p" />
    </Row>
    <Row>
        <Key
            app:code="42"
            app:keyEdgeFlags="left"
            app:keyLabel="*"
            app:keySublabel="#"
            app:keyWidth="25%p" />
        <Key
            app:code="48"
            app:keyLabel="0"
            app:keySublabel="+"
            app:keyWidth="25%p"
            app:popupCharacters="-+,./"
            app:popupKeyboard="@xml/keyboard_popup_template" />
        <Key
            app:code="46"
            app:keyLabel="."
            app:keyWidth="25%p" />
        <Key
            app:code="-4"
            app:keyEdgeFlags="right"
            app:keyIcon="@drawable/ic_enter_vector"
            app:keyWidth="25%p" />
    </Row>
</Keyboard>
