<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/minikeyboard_selected_background" android:state_focused="true" />
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="@dimen/key_vertical_margin"
                android:left="@dimen/key_horizontal_margin"
                android:right="@dimen/key_horizontal_margin"
                android:top="@dimen/key_vertical_margin">
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <corners android:radius="@dimen/key_pill_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
